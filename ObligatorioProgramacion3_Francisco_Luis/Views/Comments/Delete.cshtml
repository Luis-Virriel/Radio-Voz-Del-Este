@model ObligatorioProgramacion3_Francisco_Luis.Models.Comment

@{
    ViewBag.Title = "Delete";
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bona+Nova+SC:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="@Url.Content("~/Content/Styles/StyleComments/StyleDeleteComments.css")" rel="stylesheet" type="text/css" />
<div class="delete-container">
    <h2 class="delete-title">Eliminar Comentario</h2>
    <p class="confirm-text">¿Estás seguro que quieres eliminar este comentario?</p>

    <h4>Comentario</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Comentario</dt>
        <dd>@Html.DisplayFor(m => m.Comment1)</dd>

        <dt>Fecha Comentario</dt>
        <dd>@Html.DisplayFor(m => m.CommentDate)</dd>

        <dt>Cliente</dt>
        <dd>@Html.DisplayFor(m => m.Client.FirstName)</dd>

        <dt>Programa</dt>
        <dd>@Html.DisplayFor(m => m.RadioProgram.ProgramName)</dd>
    </dl>


    <div class="button-container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Eliminar" class="btn-delete" />
        }
        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "delete-page-back-button" })
    </div>
</div>
