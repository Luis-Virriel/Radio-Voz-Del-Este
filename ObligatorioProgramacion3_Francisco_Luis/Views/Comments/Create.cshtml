@model ObligatorioProgramacion3_Francisco_Luis.Models.Comment
@{
    ViewBag.Title = "Create";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bona+Nova+SC:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="@Url.Content("~/Content/Styles/StyleComments/StyleCreateComments.css")" rel="stylesheet" type="text/css" />

<div class="form-containerComment">
    <h2 class="form-titleComment">Crear Comentario</h2>
    <hr class="create-divider" />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                Cliente
                <div>
                    @Html.DropDownList("ClientID", null, "-- Seleccione Cliente --", htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ClientID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                Programa
                <div>
                    @Html.DropDownList("ProgramID", null, "-- Seleccione Programa --", htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ProgramID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                Comentario
                <div>
                    @Html.TextAreaFor(model => model.Comment1, new { @class = "form-control", placeholder = "Ingrese Su Comentario..." })
                    @Html.ValidationMessageFor(model => model.Comment1, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                Fecha de Comentario
                <div>
                    @Html.EditorFor(model => model.CommentDate, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local" } })
                    @Html.ValidationMessageFor(model => model.CommentDate, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="buttons-container">
                <input type="submit" value="Crear" class="btn-default" />
                <div class="back-link">
                    @Html.ActionLink("← Volver a la Lista", "Index")
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script type="text/javascript">
        $(document).ready(function () {
            
            var commentDateField = $('#CommentDate');
            if (commentDateField.val() === '') {
                var now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                commentDateField.val(now.toISOString().slice(0, 16));
            }

            
            $('.form-control').on('focus', function () {
                $(this).parent().addClass('focused');
            });

            $('.form-control').on('blur', function () {
                $(this).parent().removeClass('focused');
            });
        });
    </script>
}